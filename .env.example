# ==============================================================================
# Credit Risk Intelligence Platform - Environment Configuration Template
# Copy this file to .env and configure the appropriate values.
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# ML Artifact Paths
MODEL_PATH=artifacts/catboost_credit_risk_model.cbm
FEATURE_COLUMNS_PATH=artifacts/feature_columns.pkl
MODEL_METADATA_PATH=artifacts/model_metadata.json
RISK_CONFIG_PATH=artifacts/risk_config.json

# Talk-to-Data / LLM Provider Configuration
# Supported options: groq, openrouter, openai, anthropic, gemini, ollama
LLM_PROVIDER=groq
LLM_TEMPERATURE=0.0

# Provider-Specific API Keys & Models
# 1. Groq (High-Speed Inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2. OpenRouter (Multi-Model Gateway)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# 3. OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 4. Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 5. Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 6. Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Database Configuration
DATABASE_PATH=data/credit_risk_analytics.db
FEATURE_STORE_PATH=data/model_features.db
